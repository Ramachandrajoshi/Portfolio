{
  "name": "ramachandra-joshi-portfolio",
  "version": "0.2.0",
  "private": true,
  "description": "Ram's Digital Metropolis — the immersive architecture portfolio of Ramachandra Joshi, Solution Architect.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build-diagrams.ts && velite build && next dev",
    "content": "tsx scripts/build-diagrams.ts && velite build",
    "og": "tsx scripts/generate-og.tsx",
    "build": "pnpm content && pnpm og && next build && pnpm search:index",
    "search:index": "pagefind --site out --output-subdir pagefind",
    "verify": "tsx scripts/check-export.ts && tsx scripts/check-budgets.ts",
    "preview": "tsx scripts/serve-static.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "prepare": "husky || true",
    "budgets": "tsx scripts/check-budgets.ts"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "schema-dts": "^2.1.0",
    "tailwind-merge": "^3.7.0",
    "three": "~0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@terrastruct/d2": "^0.1.33",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mermaid": "^12.2.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.63.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unist-util-visit": "^5.2.0",
    "velite": "0.4.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@parcel/watcher"
    ],
    "ignoredBuiltDependencies": [
      "es5-ext"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": "prettier --write"
  }
}
