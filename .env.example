# ─────────────────────────────────────────────────────────────────────────────
# Environment variables. Copy to .env.local for local development.
# All of these are PUBLIC build-time values — never put secrets in NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute public URL of the site root, including any sub-path, no trailing slash.
# The Next.js basePath/assetPrefix are derived from its path. Examples:
#   GitHub Pages project site:  https://ramachandrajoshi.github.io/Portfolio
#   Custom domain at the root:  https://example.com
# Default (unset): http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Formspree form id (the part after https://formspree.io/f/). Public by design.
# Unset: the contact page shows LinkedIn/email alternatives instead of the form.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Show "to be supplied" placeholder markers in a production build (preview only).
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# Include draft articles in a local build (never in CI or deploys).
SHOW_DRAFTS=false
